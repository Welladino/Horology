# Copy this to .env and fill in real values. .env is gitignored — never commit real secrets.

# Dashboard login (protects the web UI at :9119)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-something-strong

# Host filesystem permissions for files Hermes writes into hermes-data/
# Run `id -u` / `id -g` to find your own values if the defaults don't match.
PUID=1000
PGID=1000

# --- Provider / model keys go through the Hermes setup wizard, not here ---
# They get written to hermes-data/.env automatically after `docker compose run --rm hermes setup`.
# (OpenRouter API key, etc. — entered interactively, not stored in this file.)
