# Copy this to .env and fill in real values. .env is gitignored — never commit real secrets.

# Dashboard login (protects the web UI at :9119)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-something-strong

# Host filesystem permissions for files Hermes writes into hermes-data/
# Run `id -u` / `id -g` to find your own values if the defaults don't match.
PUID=1000
PGID=1000

# --- Provider / model / tool keys go through hermes-data/.env, NOT this file ---
# They get written there automatically after `docker compose run --rm hermes setup`,
# or added manually (e.g. `echo "TAVILY_API_KEY=..." >> hermes-data/.env`).
# (OpenRouter API key, TAVILY_API_KEY for web search, etc.)
# Common mistake: adding these to the root .env instead — root .env is read by
# Docker Compose for container environment vars, NOT by Hermes itself.

# --- Neon Postgres (document graph: documents / document_links / run_log) ---
# From Neon dashboard -> Connection Details. Get BOTH strings, they are different:

# Direct connection (no "-pooler" in hostname). Used for Alembic migrations ONLY —
# transaction-mode pooling doesn't support everything migrations may need.
DATABASE_URL=postgresql://user:password@ep-example-123456.region.aws.neon.tech/dbname?sslmode=require

# Pooled connection (has "-pooler" in hostname). Used by Hermes's runtime doc-graph
# queries later (via MCP) — short-lived queries, not migrations.
DATABASE_URL_POOLED=postgresql://user:password@ep-example-123456-pooler.region.aws.neon.tech/dbname?sslmode=require

# --- GitHub monitoring (read-only, single-repo) ---
# Fine-grained PAT scoped to ONE repo, Contents/Issues/PRs/Actions: Read-only,
# everything else: No access. Create at github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
GITHUB_REPO=Welladino/Article_aggregator_agent

# --- OpenRouter key, for document-graph-mcp's auto_link_similar_documents tool ---
# Same key as Hermes's own OPENROUTER_API_KEY (in hermes-data/.env) - copy the
# same value here too. document-graph-mcp calls OpenRouter's /v1/embeddings
# endpoint (google/gemini-embedding-001) directly, kept as its own credential
# per the "each MCP server holds its own credential, never shares Hermes's
# environment" pattern - not mounting hermes-data/.env into this container.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
