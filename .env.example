# Copy this file to .env. The real file is ignored by Git.
# Service-specific credentials belong in that service's own private env file.

# Hermes dashboard at http://127.0.0.1:9119
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-a-long-random-value

# Host ownership for files Hermes writes under hermes-data/.
# On macOS/Linux, run: id -u
# Then run: id -g
PUID=1000
PGID=1000

# Direct, unpooled Neon owner connection used only by Alembic and explicit
# operator scripts. Runtime services must use their dedicated restricted roles.
DATABASE_URL=postgresql://owner:password@ep-example.region.aws.neon.tech/database?sslmode=require

# Read-only role used by scripts/check_unembedded_documents.py inside Hermes.
# The sweep may be paused, but Compose currently requires this variable.
CRON_SWEEP_RO_DATABASE_URL=postgresql://horology_cron_sweep_ro:password@ep-example-pooler.region.aws.neon.tech/database?sslmode=require

# Do not put model/provider keys here:
# - Hermes-managed keys live in hermes-data/.env.
# - Document graph values live in mcp-servers/document-graph/.env.
# - Gateway values live in mcp-servers/mcp-gateway/.env.local.
