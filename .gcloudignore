# Cloud Build source upload: the whole repository, minus what is listed here.
# Check what would be uploaded with: gcloud meta list-files-for-upload .

# Everything Git ignores (.env files, Hermes state, caches, build output, clasp logins).
#!include:.gitignore

# Secrets and local state, listed again so a change to .gitignore can't start uploading them.
# Nested .gitignore files (tests/manual/gateway/fixtures/private/) are not read by gcloud.
**/.env
**/.env.*
**/*.local.json
**/fixtures/private/**
.auth/
reports/
hermes-data/
hermes/hermes-output/
mcp-servers/mcp-gateway/**/state/
mcp-servers/mcp-gateway/config/client.cloud.json
**/.clasp.json
**/.clasprc*.json

# Not needed by the build or its tests.
.git/
.github/
.gcloudignore
.venv/
**/node_modules/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.hypothesis/
plugins/dist/
**/.DS_Store
