*
!shared-runtime/
!shared-runtime/pyproject.toml
!shared-runtime/horology_runtime/
!shared-runtime/horology_runtime/*.py
!shared-runtime/horology_runtime/oauth/
!shared-runtime/horology_runtime/oauth/*.py
!shared-runtime/horology_runtime/oauth/*.css
# Graph logic shared by the document-graph service and its sync job.
!document-graph-core/
!document-graph-core/pyproject.toml
!document-graph-core/graph_core/
!document-graph-core/graph_core/**/
!document-graph-core/graph_core/**/*.py
!document-graph-core/graph_core/*.py
!mcp-servers/
!mcp-servers/mcp-gateway/
!mcp-servers/mcp-gateway/requirements.txt
!mcp-servers/mcp-gateway/server.py
!mcp-servers/mcp-gateway/policy.py
!mcp-servers/mcp-gateway/integrations/
!mcp-servers/mcp-gateway/integrations/**/
!mcp-servers/mcp-gateway/integrations/**/*.py
!mcp-servers/mcp-gateway/shared/
!mcp-servers/mcp-gateway/shared/*.py
!mcp-servers/mcp-gateway/certs/
!mcp-servers/mcp-gateway/certs/supabase-prod-ca-2021.crt
!mcp-servers/mcp-gateway/config/
!mcp-servers/mcp-gateway/config/policy.cloud.json
!mcp-servers/document-graph/
!mcp-servers/document-graph/requirements.txt
!mcp-servers/document-graph/server.py
!mcp-servers/document-graph/document_graph/
!mcp-servers/document-graph/document_graph/**/
!mcp-servers/document-graph/document_graph/**/*.py
!mcp-servers/document-graph/document_graph/*.py
# The Pipeline workflow, read by the history tools to check values and changes.
!plugins/
!plugins/horology-workflows/
!plugins/horology-workflows/skills/
!plugins/horology-workflows/skills/horology-capture-triage/
!plugins/horology-workflows/skills/horology-capture-triage/references/
!plugins/horology-workflows/skills/horology-capture-triage/references/workflow.yaml
**/__pycache__/


!mcp-servers/mcp-gateway/database/
!mcp-servers/mcp-gateway/database/**/
!mcp-servers/mcp-gateway/database/**/*.py
!mcp-servers/mcp-gateway/database/*.py

# Document Index sync job, packaged into the document-graph image.
!jobs/
!jobs/document-graph-sync/
!jobs/document-graph-sync/requirements.txt
!jobs/document-graph-sync/graph_sync/
!jobs/document-graph-sync/graph_sync/*.py
